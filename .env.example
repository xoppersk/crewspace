# Supabase — copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Project Settings → API.
#
# REPLACE_ME — these placeholders are NOT real credentials. They only exist so
# the shape of the file is obvious. Never commit real keys.

# Public project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co

# Public anon key (safe to expose in the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY

# Service-role key — SERVER ONLY. Never expose to the browser, never commit.
# Used by Edge Functions / server actions for invitation-token issuance and
# the expiry sweeper. Bypasses RLS: treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVICE_ROLE_KEY

# Resend API key — SERVER ONLY. Used by the send-invitation Edge Function
# (invitation emails). Never commit.
RESEND_API_KEY=REPLACE_ME_RESEND_KEY

# Base URL of the app, used to build email redirect links (magic link,
# signup confirmation, password reset). Defaults to window.location.origin
# when unset — set it explicitly for preview/production deployments.
NEXT_PUBLIC_APP_URL=http://localhost:3000
